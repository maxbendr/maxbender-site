---
import Base from "./Base.astro";
import { site } from "../lib/content";

interface Props {
  name: string;
  tagline: string;
  description: string;
}

const { name, tagline, description } = Astro.props;
---

<Base title={`${name} - games by ${site.name}`} description={description}>
  <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-3xl flex-col px-5 pb-16 pt-8 sm:px-6">
    <header class="flex items-baseline justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{name}</h1>
        <p class="mt-1 text-sm text-ink-soft dark:text-chalk-soft">{tagline}</p>
      </div>
      <a
        href="/games"
        class="shrink-0 font-mono text-xs text-ink-soft transition-colors hover:text-accent dark:text-chalk-soft dark:hover:text-accent-dark"
      >
        &larr; games
      </a>
    </header>

    <slot />
  </div>
</Base>
