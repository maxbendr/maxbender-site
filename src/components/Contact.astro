---
import Section from "./Section.astro";
import { obfuscateEmail, site } from "../lib/content";

const email = obfuscateEmail(site.email);
const formReady =
  site.contact.formEndpoint !== "" && !site.contact.formEndpoint.includes("[PLACEHOLDER");
---

<Section
  id="contact"
  label="Contact"
  title="Say hello."
  intro={site.contact.note}
  class="contact"
>
  <div class={formReady ? "grid gap-12 lg:grid-cols-[1fr_1.1fr]" : "grid gap-12"}>
    <div class="reveal space-y-6">
      <p class="text-lg">
        The fastest way to reach me is email. I read everything, I answer most things.
      </p>
      <div class="space-y-3 text-sm">
        <p>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft dark:text-chalk-soft">
            Email
          </span>
          <br />
          <a
            class="link-underline text-base"
            href="#contact"
            data-email-link
            data-user={email.user}
            data-domain={email.domain}
          >
            <span data-email-text>
              {email.user} at {email.domain}
            </span>
          </a>
        </p>
        <p>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft dark:text-chalk-soft">
            LinkedIn
          </span>
          <br />
          <a
            class="link-underline text-base"
            href={site.links.linkedin}
            target="_blank"
            rel="me noopener"
          >
            Connect with me
          </a>
        </p>
        <p>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft dark:text-chalk-soft">
            GitHub
          </span>
          <br />
          <a
            class="link-underline text-base"
            href={site.links.github}
            target="_blank"
            rel="me noopener"
          >
            See what I build
          </a>
        </p>
      </div>
    </div>

    {formReady && (
      <form
        class="card reveal space-y-4 p-6 sm:p-8 hover:!translate-y-0 hover:!shadow-none"
        method="POST"
        action={formReady ? site.contact.formEndpoint : undefined}
        data-contact-form
        data-ready={String(formReady)}
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="text-ink-soft dark:text-chalk-soft">Name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="edge mt-1.5 w-full rounded-lg border bg-transparent px-3 py-2 text-base outline-none transition-colors focus:border-accent dark:focus:border-accent-dark"
            />
          </label>
          <label class="block text-sm">
            <span class="text-ink-soft dark:text-chalk-soft">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="edge mt-1.5 w-full rounded-lg border bg-transparent px-3 py-2 text-base outline-none transition-colors focus:border-accent dark:focus:border-accent-dark"
            />
          </label>
        </div>
        <label class="block text-sm">
          <span class="text-ink-soft dark:text-chalk-soft">Message</span>
          <textarea
            name="message"
            rows="5"
            required
            class="edge mt-1.5 w-full rounded-lg border bg-transparent px-3 py-2 text-base outline-none transition-colors focus:border-accent dark:focus:border-accent-dark"
          ></textarea>
        </label>
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
        <button
          type="submit"
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-transform duration-200 hover:-translate-y-0.5 dark:bg-accent-dark dark:text-night"
        >
          Send
        </button>
        <p class="hidden text-sm accent" data-form-status></p>
      </form>
    )}
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-email-link]").forEach((link) => {
    const user = link.dataset.user;
    const domain = link.dataset.domain;
    if (!user || !domain) return;
    link.href = `mailto:${user}@${domain}`;
    const text = link.querySelector<HTMLElement>("[data-email-text]");
    if (text) text.textContent = `${user}@${domain}`;
  });

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  form?.addEventListener("submit", async (event) => {
    if (form.dataset.ready !== "true") {
      event.preventDefault();
      if (status) {
        status.textContent = "The form is not connected yet. Email me instead.";
        status.classList.remove("hidden");
      }
      return;
    }

    event.preventDefault();
    const response = await fetch(form.action, {
      method: "POST",
      body: new FormData(form),
      headers: { Accept: "application/json" },
    });

    if (status) {
      status.textContent = response.ok
        ? "Got it. I will get back to you."
        : "That did not send. Try email instead.";
      status.classList.remove("hidden");
    }
    if (response.ok) form.reset();
  });
</script>
