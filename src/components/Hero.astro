---
import { site } from "../lib/content";

let picIndex = 0;
---

<header class="hero mx-auto max-w-6xl px-6 pt-40 pb-16 sm:pt-48 sm:pb-24" data-hero>
  <div class="hero-stack" data-hero-stack>
    {[false, true].map((reveal) => {
      picIndex = 0;
      return (
        <h1
          class:list={[
            "hero-title text-[clamp(2.4rem,7.5vw,6.2rem)] leading-[1.02] font-semibold tracking-tight",
            reveal && "hero-reveal",
          ]}
          aria-hidden={reveal ? "true" : undefined}
        >
          {site.hero.map((seg) =>
            "text" in seg ? (
              <>
                {seg.text
                  .split(" ")
                  .filter(Boolean)
                  .map((word) => (
                    <span class="hero-word">{word}</span>
                  ))}
                {seg.break && <br />}
              </>
            ) : (
              <span class="hero-pic" data-hero-pic data-depth={((picIndex++ % 3) + 1) * 5}>
                <img
                  src={seg.image}
                  alt=""
                  width="320"
                  height="160"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  aria-hidden="true"
                />
              </span>
            ),
          )}
        </h1>
      );
    })}
  </div>
  <p class="hero-sub mt-8 max-w-xl text-lg text-ink-soft dark:text-chalk-soft">
    {site.subline}
  </p>
  <div class="hero-sub mt-8 flex flex-wrap gap-3">
    <a href="#orbit" class="btn-dark">
      See who I work with
    </a>
    <a href="#contact" class="btn">
      Say hi
    </a>
  </div>
</header>

<style>
  @property --reveal-r {
    syntax: "<length>";
    inherits: true;
    initial-value: 0rem;
  }

  .hero-stack {
    position: relative;
    transition: --reveal-r 0.5s;
    --mx: -200vw;
    --my: -200vh;
    --reveal-r: 0rem;
  }

  .hero-reveal {
    position: absolute;
    inset: 0;
    margin: 0;
    pointer-events: none;
    color: var(--color-accent);
    -webkit-mask-image: radial-gradient(
      circle var(--reveal-r, 9rem) at var(--mx) var(--my),
      #000 0%,
      rgba(0, 0, 0, 0.9) 45%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle var(--reveal-r, 9rem) at var(--mx) var(--my),
      #000 0%,
      rgba(0, 0, 0, 0.9) 45%,
      transparent 100%
    );
  }

  :global(.dark) .hero-reveal {
    color: var(--color-accent-dark);
  }

  .hero-reveal .hero-word,
  .hero-reveal .hero-pic {
    opacity: 1;
    transform: none;
    animation: none;
  }

  .hero-reveal .hero-pic img {
    filter: saturate(1.4) contrast(1.05);
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.28em;
    opacity: 0;
    transform: translateY(0.9em) rotate(2deg);
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  .hero-word:nth-child(1) {
    --i: 0;
  }
  .hero-word:nth-child(2) {
    --i: 1;
  }
  .hero-word:nth-child(3) {
    --i: 2;
  }
  .hero-word:nth-child(5) {
    --i: 3;
  }
  .hero-word:nth-child(6) {
    --i: 4;
  }
  .hero-word:nth-child(8) {
    --i: 5;
  }
  .hero-word:nth-child(9) {
    --i: 6;
  }
  .hero-word:nth-child(10) {
    --i: 7;
  }
  .hero-word:nth-child(12) {
    --i: 8;
  }
  .hero-word:nth-child(13) {
    --i: 9;
  }
  .hero-word:nth-child(14) {
    --i: 10;
  }
  .hero-word:nth-child(16) {
    --i: 11;
  }

  .hero-word:nth-child(9),
  .hero-word:nth-child(10) {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }

  .hero-pic {
    display: inline-block;
    width: 2.1em;
    height: 1.05em;
    margin: 0 0.28em 0 0.05em;
    overflow: hidden;
    border-radius: 999px;
    vertical-align: -0.12em;
    opacity: 0;
    animation: pop 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .hero-pic:hover img {
    transform: scale(1.12);
  }

  .hero-sub {
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.9s forwards;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pop {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .hero-pic,
    .hero-sub {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const stack = document.querySelector<HTMLElement>("[data-hero-stack]");
  const pics = [...document.querySelectorAll<HTMLElement>("[data-hero-pic]")];
  const fine = window.matchMedia("(pointer: fine)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && stack && !still.matches) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let on = false;
    let raf = 0;

    const frame = () => {
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      stack.style.setProperty("--mx", `${x}px`);
      stack.style.setProperty("--my", `${y}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(frame) : 0;
    };

    const aim = (e: PointerEvent) => {
      const r = stack.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!on) {
        on = true;
        x = tx;
        y = ty;
        stack.style.setProperty("--reveal-r", "9rem");
      }
      if (!raf) raf = requestAnimationFrame(frame);
    };

    hero.addEventListener("pointermove", aim, { passive: true });
    hero.addEventListener("pointerdown", aim, { passive: true });
    hero.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      on = false;
      stack.style.setProperty("--reveal-r", "0rem");
    });
  }

  if (hero && pics.length && fine.matches) {
    hero.addEventListener(
      "pointermove",
      (e) => {
        if (still.matches) return;
        const r = hero.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5;
        const dy = (e.clientY - r.top) / r.height - 0.5;
        for (const pic of pics) {
          const depth = Number(pic.dataset.depth ?? 5);
          pic.style.setProperty("--px", `${dx * depth * 2}px`);
          pic.style.setProperty("--py", `${dy * depth * 2}px`);
        }
      },
      { passive: true },
    );
    hero.addEventListener("pointerleave", () => {
      for (const pic of pics) {
        pic.style.setProperty("--px", "0px");
        pic.style.setProperty("--py", "0px");
      }
    });
  }
</script>
