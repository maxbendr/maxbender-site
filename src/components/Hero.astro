---
import { site } from "../lib/content";

let picIndex = 0;
---

<header class="hero mx-auto max-w-6xl px-6 pt-40 pb-16 sm:pt-48 sm:pb-24" data-hero>
  <h1 class="hero-title text-[clamp(2.4rem,7.5vw,6.2rem)] leading-[1.02] font-semibold tracking-tight">
    {site.hero.map((seg) =>
      "text" in seg ? (
        <>
          {seg.text.split(" ").map((word) => (
            <span class="hero-word">{word}</span>
          ))}
          {seg.break && <br />}
        </>
      ) : (
        <span class="hero-pic" data-hero-pic data-depth={((picIndex++ % 3) + 1) * 5}>
          <img
            src={seg.image}
            alt=""
            width="320"
            height="160"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            aria-hidden="true"
          />
        </span>
      ),
    )}
  </h1>
  <p class="hero-sub mt-8 max-w-xl text-lg text-ink-soft dark:text-chalk-soft">
    {site.subline}
  </p>
  <div class="hero-sub mt-8 flex flex-wrap gap-3">
    <a href="#orbit" class="btn-dark">
      See who I work with
    </a>
    <a href="#contact" class="btn">
      Say hi
    </a>
  </div>
</header>

<style>
  .hero-word {
    display: inline-block;
    margin-right: 0.28em;
    opacity: 0;
    transform: translateY(0.9em) rotate(2deg);
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  .hero-word:nth-child(1) {
    --i: 0;
  }
  .hero-word:nth-child(2) {
    --i: 1;
  }
  .hero-word:nth-child(3) {
    --i: 2;
  }
  .hero-word:nth-child(5) {
    --i: 3;
  }
  .hero-word:nth-child(6) {
    --i: 4;
  }
  .hero-word:nth-child(8) {
    --i: 5;
  }
  .hero-word:nth-child(9) {
    --i: 6;
  }
  .hero-word:nth-child(10) {
    --i: 7;
  }
  .hero-word:nth-child(12) {
    --i: 8;
  }
  .hero-word:nth-child(13) {
    --i: 9;
  }
  .hero-word:nth-child(14) {
    --i: 10;
  }
  .hero-word:nth-child(16) {
    --i: 11;
  }

  .hero-word:nth-child(9),
  .hero-word:nth-child(10) {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }

  .hero-pic {
    display: inline-block;
    width: 2.1em;
    height: 1.05em;
    margin: 0 0.28em 0 0.05em;
    overflow: hidden;
    border-radius: 999px;
    vertical-align: -0.12em;
    opacity: 0;
    animation: pop 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .hero-pic:hover img {
    transform: scale(1.12);
  }

  .hero-sub {
    opacity: 0;
    animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.9s forwards;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pop {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .hero-pic,
    .hero-sub {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const pics = [...document.querySelectorAll<HTMLElement>("[data-hero-pic]")];
  const fine = window.matchMedia("(pointer: fine)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && pics.length && fine.matches) {
    hero.addEventListener(
      "pointermove",
      (e) => {
        if (still.matches) return;
        const r = hero.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5;
        const dy = (e.clientY - r.top) / r.height - 0.5;
        for (const pic of pics) {
          const depth = Number(pic.dataset.depth ?? 5);
          pic.style.setProperty("--px", `${dx * depth * 2}px`);
          pic.style.setProperty("--py", `${dy * depth * 2}px`);
        }
      },
      { passive: true },
    );
    hero.addEventListener("pointerleave", () => {
      for (const pic of pics) {
        pic.style.setProperty("--px", "0px");
        pic.style.setProperty("--py", "0px");
      }
    });
  }
</script>
