---
import Section from "./Section.astro";
import { background, site } from "../lib/content";
---

<Section id="background" label="Background" title="How I got here." intro={background.intro}>
  <ol class="relative">
    {background.timeline.map((item, index) => (
      <li
        class="reveal edge grid gap-1 border-t py-6 sm:grid-cols-[10rem_1fr] sm:gap-8"
        style={`transition-delay:${index * 40}ms`}
      >
        <p class="font-mono text-sm text-ink-soft dark:text-chalk-soft">{item.period}</p>
        <div>
          <h3 class="text-lg font-medium tracking-tight">{item.title}</h3>
          <p class="mt-1 text-sm text-ink-soft dark:text-chalk-soft">
            {item.location}
            {item.note ? ` - ${item.note}` : ""}
          </p>
        </div>
      </li>
    ))}
  </ol>

  <a
    href={site.cvUrl}
    class="edge reveal mt-10 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-colors duration-200 hover:border-accent hover:text-accent dark:hover:border-accent-dark dark:hover:text-accent-dark"
    download
  >
    Download my CV
    <span class="font-mono text-xs text-ink-soft dark:text-chalk-soft">PDF</span>
  </a>
  <p class="mt-3 font-mono text-xs text-ink-soft dark:text-chalk-soft">
    [PLACEHOLDER: drop the real CV at public{site.cvUrl}]
  </p>
</Section>
