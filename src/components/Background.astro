---
import Section from "./Section.astro";
import { background } from "../lib/content";
---

<Section id="background" label="About" title="How I got here." intro={background.intro}>
  <ol class="relative">
    {background.timeline.map((item, index) => (
      <li
        class="reveal edge grid gap-1 border-t py-6 sm:grid-cols-[10rem_1fr] sm:gap-8"
        style={`transition-delay:${index * 40}ms`}
      >
        <p class="font-mono text-sm text-ink-soft dark:text-chalk-soft">{item.period}</p>
        <div>
          <h3 class="text-lg font-medium tracking-tight">{item.title}</h3>
          {(item.location || item.note) && (
            <p class="mt-1 text-sm text-ink-soft dark:text-chalk-soft">
              {[item.location, item.note].filter(Boolean).join(" - ")}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
</Section>
