---
import Section from "./Section.astro";
import { building } from "../lib/content";
import { liveGames } from "../lib/games";
---

<Section id="building" label={building.label} title={building.title} intro={building.intro}>
  <div class="grid gap-5 sm:grid-cols-3">
    {building.items.map((item, index) => (
      <article
        class="card reveal flex flex-col p-6 sm:p-7"
        style={`transition-delay:${index * 60}ms`}
      >
        <span class="eyebrow">0{index + 1}</span>
        <h3 class="mt-3 text-xl font-semibold tracking-tight">{item.title}</h3>
        <p class="mt-2 text-ink-soft dark:text-chalk-soft">{item.text}</p>
      </article>
    ))}
  </div>

  <div class="card reveal mt-10 overflow-hidden hover:!translate-y-0 hover:!shadow-none">
    <div class="flex flex-col gap-4 p-7 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="eyebrow">Games</p>
        <p class="mt-3 text-xl font-semibold tracking-tight">
          Small browser games, classics with one thing changed.
        </p>
        <p class="mt-2 text-ink-soft dark:text-chalk-soft">
          No account, no ads, nothing to install. They run in a tab.
        </p>
      </div>
      <a href="/games" class="btn shrink-0 self-start sm:self-auto">
        Open the arcade
      </a>
    </div>
    <ul class="edge grid border-t sm:grid-cols-3">
      {liveGames.map((game) => (
        <li class="edge border-t sm:border-t-0 sm:border-l sm:first:border-l-0">
          <a href={`/games/${game.slug}`} class="group flex h-full flex-col p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h4 class="font-medium tracking-tight transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                {game.name}
              </h4>
              <span class="font-mono text-[11px] text-ink-soft dark:text-chalk-soft">
                {game.session}
              </span>
            </div>
            <p class="mt-2 text-sm text-ink-soft dark:text-chalk-soft">{game.tagline}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>
