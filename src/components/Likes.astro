---
import Section from "./Section.astro";
import { likes } from "../lib/content";
---

<Section id="likes" label="What I like" title="Off the clock." intro={likes.intro}>
  <ul class="grid gap-px overflow-hidden rounded-2xl bg-[var(--edge)] sm:grid-cols-2">
    {likes.items.map((item, index) => (
      <li
        class="reveal bg-paper p-7 transition-colors duration-300 hover:bg-paper-soft dark:bg-night dark:hover:bg-night-soft"
        style={`transition-delay:${index * 50}ms`}
      >
        <h3 class="text-lg font-medium tracking-tight">{item.title}</h3>
        <p class="mt-1 text-ink-soft dark:text-chalk-soft">{item.body}</p>
      </li>
    ))}
  </ul>
</Section>
