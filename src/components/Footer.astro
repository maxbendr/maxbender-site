---
import { site } from "../lib/content";

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-6">
  <div class="edge flex flex-col gap-4 border-t py-10 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between dark:text-chalk-soft">
    <p>
      {site.name}, {year}. Built with AI and too much coffee.
    </p>
    <div class="flex flex-wrap gap-5">
      <a class="link-underline" href={site.links.linkedin} rel="me noopener" target="_blank">
        LinkedIn
      </a>
      <a class="link-underline" href={site.links.github} rel="me noopener" target="_blank">
        GitHub
      </a>
      {site.links.substack && (
        <a class="link-underline" href={site.links.substack} rel="noopener" target="_blank">
          Substack
        </a>
      )}
      <a class="link-underline" href="/games/">
        Games
      </a>
      <a class="link-underline" href="/now">
        Now
      </a>
    </div>
  </div>
</footer>
