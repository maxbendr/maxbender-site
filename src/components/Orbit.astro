---
import { orbit } from "../lib/content";

const n = orbit.players.length;
/* Starting angle, radius ratio and tilt per word; one shared speed keeps the words evenly spaced. */
const words = orbit.players.map((p, i) => ({
  ...p,
  angle: (i / n) * 360 + 65,
  radius: 0.86 + (i % 2) * 0.16,
  speed: 1,
  tilt: ((i % 3) - 1) * 6,
}));
---

<section id="orbit" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="reveal text-center">
    <p class="eyebrow">{orbit.label}</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-3xl font-semibold tracking-tight sm:text-5xl">
      {orbit.title}
      <span class="text-ink-soft dark:text-chalk-soft">{orbit.hint}</span>
    </h2>
  </div>

  <div class="stage reveal" data-stage>
    <div class="halo" aria-hidden="true"></div>
    <div class="halo halo-b" aria-hidden="true"></div>
    <div class="core" aria-hidden="true"></div>
    <ul class="words" role="list">
      {words.map((w) => (
        <li
          class="word"
          data-word
          data-angle={w.angle}
          data-radius={w.radius}
          data-speed={w.speed}
          data-tilt={w.tilt}
          style={`--angle:${w.angle}deg;--r:${w.radius};--tilt:${w.tilt}deg`}
        >
          <button
            type="button"
            class={`word-btn font-${w.font}`}
            data-open={w.id}
            aria-haspopup="dialog"
            aria-controls={`player-${w.id}`}
          >
            {w.label}
          </button>
        </li>
      ))}
    </ul>
  </div>

  {orbit.players.map((p) => (
    <dialog id={`player-${p.id}`} class="player" aria-labelledby={`player-${p.id}-title`}>
      <div class="player-card">
        <p class="eyebrow">{orbit.label}</p>
        <h3 id={`player-${p.id}-title`} class={`font-${p.font} mt-2 text-4xl sm:text-5xl`}>
          {p.label}
        </h3>
        <p class="mt-4 text-lg text-ink-soft dark:text-chalk-soft">{p.lead}</p>
        <ul class="mt-6 space-y-3">
          {p.items.map((item) => (
            <li class="edge flex gap-3 border-t pt-3">
              <span class="accent mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-current" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <form method="dialog" class="mt-8 flex justify-end">
          <button type="submit" class="btn">
            Close
          </button>
        </form>
      </div>
    </dialog>
  ))}
</section>

<style>
  .stage {
    --size: min(88vw, 40rem);
    --rx: 1;
    position: relative;
    width: var(--size);
    height: var(--size);
    margin: 3rem auto 0;
  }

  .halo {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.16), transparent 70%);
    animation: breathe 9s ease-in-out infinite;
  }

  .halo-b {
    inset: 28%;
    background: radial-gradient(circle, rgba(255, 178, 140, 0.22), transparent 70%);
    animation-delay: -4s;
  }

  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-accent);
    translate: -50% -50%;
    box-shadow: 0 0 0 0.6rem rgba(var(--accent-rgb), 0.12);
    animation: pulse 3s ease-in-out infinite;
  }

  :global(.dark) .core {
    background: var(--color-accent-dark);
  }

  .words {
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .word {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%)
      translate(
        calc(cos(var(--angle)) * var(--r) * var(--rx) * var(--size) / 2),
        calc(sin(var(--angle)) * var(--r) * var(--size) / 2 * 0.7)
      )
      rotate(var(--tilt)) scale(var(--depth, 1));
    opacity: calc(0.55 + var(--depth, 1) * 0.45);
    filter: blur(calc((1 - var(--depth, 1)) * 2px));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: nowrap;
  }

  .stage.is-live .word {
    transition: none;
  }

  @media (max-width: 640px) {
    .stage {
      --rx: 0.72;
    }
  }

  .word-btn {
    background: none;
    border: 0;
    padding: 0.3em 0.4em;
    color: inherit;
    font-size: clamp(1.15rem, 4.5vw, 2.6rem);
    line-height: 1;
    transition:
      color 0.3s,
      transform 0.3s;
  }

  .word-btn:hover,
  .word-btn:focus-visible {
    color: var(--color-accent);
    transform: scale(1.08);
    outline: none;
  }

  :global(.dark) .word-btn:hover,
  :global(.dark) .word-btn:focus-visible {
    color: var(--color-accent-dark);
  }

  .font-fraunces {
    font-family: "Fraunces Variable", serif;
    font-weight: 300;
    font-variation-settings: "opsz" 144;
  }

  .font-instrument {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-weight: 400;
  }

  .font-unbounded {
    font-family: "Unbounded Variable", sans-serif;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(1rem, 3.2vw, 1.9rem);
  }

  .font-bricolage {
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-weight: 800;
    font-variation-settings: "wdth" 110;
  }

  .font-dmserif {
    font-family: "DM Serif Display", serif;
    font-style: italic;
  }

  .font-syne {
    font-family: "Syne Variable", sans-serif;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 3.6vw, 2.1rem);
  }

  .font-spacegrotesk {
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }

  .player {
    position: fixed;
    inset: 0;
    margin: auto;
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 34rem);
    width: 100%;
    max-height: 90vh;
    height: fit-content;
    color: inherit;
  }

  .player::backdrop {
    background: rgba(17, 17, 17, 0.35);
    backdrop-filter: blur(8px);
  }

  .player[open] {
    animation: player-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .player-card {
    background: var(--card);
    border: 1px solid var(--edge);
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.2);
  }

  @keyframes breathe {
    50% {
      transform: scale(1.12);
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 1.4rem rgba(var(--accent-rgb), 0.04);
    }
  }

  @keyframes player-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const words = [...document.querySelectorAll<HTMLElement>("[data-word]")];
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-open]")) {
    const dialog = document.getElementById(`player-${btn.dataset.open}`);
    if (dialog instanceof HTMLDialogElement) {
      btn.addEventListener("click", () => dialog.showModal());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }

  if (stage && words.length && !still.matches) {
    const state = words.map((el) => ({
      el,
      angle: Number(el.dataset.angle),
      radius: Number(el.dataset.radius),
      speed: Number(el.dataset.speed),
      tilt: Number(el.dataset.tilt),
      phase: Math.random() * Math.PI * 2,
    }));
    let slow = false;
    let last = performance.now();
    let raf = 0;

    stage.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "mouse") slow = true;
    });
    stage.addEventListener("pointerleave", () => (slow = false));

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      for (const w of state) {
        w.angle += dt * w.speed * (slow ? 4 : 14);
        const breathe = Math.sin(now / 1800 + w.phase) * 0.04;
        const bob = Math.sin(now / 1300 + w.phase) * 3;
        w.el.style.setProperty("--angle", `${w.angle}deg`);
        w.el.style.setProperty("--r", `${w.radius + breathe}`);
        w.el.style.setProperty("--tilt", `${w.tilt + bob}deg`);
        const depth = 0.82 + ((Math.sin((w.angle * Math.PI) / 180) + 1) / 2) * 0.28;
        w.el.style.setProperty("--depth", depth.toFixed(3));
      }
      raf = requestAnimationFrame(tick);
    };

    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) {
          stage.classList.add("is-live");
          if (!raf) {
            last = performance.now();
            raf = requestAnimationFrame(tick);
          }
        } else if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      },
      { rootMargin: "100px" },
    ).observe(stage);
  }
</script>
