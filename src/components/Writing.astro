---
import Section from "./Section.astro";
import { formatPostDate, getPosts, postHref, readingTime, site, writing } from "../lib/content";

const posts = (await getPosts()).slice(0, 3);
const dateFormat = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" });
---

<Section id="writing" label="Writing" title="Things I write down." intro={writing.intro}>
  {posts.length > 0 && (
    <ul
      class:list={[
        "grid gap-px overflow-hidden rounded-2xl bg-[var(--edge)]",
        posts.length === 2 && "sm:grid-cols-2",
        posts.length >= 3 && "sm:grid-cols-3",
      ]}
    >
      {posts.map((post, index) => (
        <li
          class="reveal bg-paper transition-colors duration-300 hover:bg-paper-soft dark:bg-night dark:hover:bg-night-soft"
          style={`transition-delay:${index * 50}ms`}
        >
          <a
            href={postHref(post)}
            target={post.data.external ? "_blank" : undefined}
            rel={post.data.external ? "noopener" : undefined}
            class="group flex h-full flex-col p-7"
          >
            <p class="font-mono text-xs text-ink-soft dark:text-chalk-soft">
              {formatPostDate(post.data.date)}
              {!post.data.external && (
                <>
                  <span class="mx-2">/</span>
                  {readingTime(post.body ?? "")}
                </>
              )}
            </p>
            <h3 class="mt-3 text-lg font-medium tracking-tight transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
              {post.data.title}
            </h3>
            {post.data.subtitle && (
              <p class="mt-2 text-sm text-ink-soft dark:text-chalk-soft">
                {post.data.subtitle}
              </p>
            )}
            <span class="mt-auto pt-6 font-mono text-xs accent">
              {post.data.external ? "Read on Substack" : "Read"}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {posts.length === 0 && (
    <p class="reveal font-mono text-xs text-ink-soft dark:text-chalk-soft">
      Nothing published yet. Drop a Markdown file in content/posts and it shows up here.
    </p>
  )}

  <p class="reveal mt-6">
    <a class="link-underline text-sm font-medium" href="/writing/">
      All writing
    </a>
  </p>

  {writing.posts.length > 0 && (
    <>
      <h3 class="reveal mt-16 font-mono text-xs uppercase tracking-[0.2em] accent">
        On LinkedIn
      </h3>
      <ul class="mt-4">
        {writing.posts.map((post, index) => (
          <li class="reveal edge border-t" style={`transition-delay:${index * 50}ms`}>
            <a
              href={post.url}
              target="_blank"
              rel="noopener"
              class="group grid gap-2 py-6 transition-colors sm:grid-cols-[9rem_1fr] sm:gap-8"
            >
              <span class="font-mono text-sm text-ink-soft dark:text-chalk-soft">
                {dateFormat.format(new Date(post.date))}
              </span>
              <span>
                <span class="block text-lg font-medium tracking-tight transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                  {post.title}
                </span>
                <span class="mt-1 block text-sm text-ink-soft dark:text-chalk-soft">
                  {post.summary}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="reveal edge mt-12 flex flex-col items-start gap-5 rounded-2xl border p-8 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xl font-semibold tracking-tight">
        {site.links.substack
          ? "New posts land in your inbox."
          : "I post most of my thinking on LinkedIn."}
      </p>
      <p class="mt-2 text-ink-soft dark:text-chalk-soft">
        Open innovation, startup programs, and what I break while building with AI.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      {site.links.substack && (
        <a
          href={site.links.substack}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-transform duration-200 hover:-translate-y-0.5 dark:bg-accent-dark dark:text-night"
        >
          Subscribe on Substack
        </a>
      )}
      <a
        href={site.links.linkedin}
        target="_blank"
        rel="me noopener"
        class:list={[
          "rounded-full px-5 py-2.5 text-sm font-medium transition-transform duration-200 hover:-translate-y-0.5",
          site.links.substack
            ? "edge border"
            : "bg-accent text-white dark:bg-accent-dark dark:text-night",
        ]}
      >
        Follow me on LinkedIn
      </a>
    </div>
  </div>
</Section>
