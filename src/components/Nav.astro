---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../lib/content";

interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<header
  class="pointer-events-none fixed inset-x-0 top-5 z-40 flex justify-center px-4"
  data-nav
>
  <nav
    class="pill pointer-events-auto flex max-w-full items-center gap-1 overflow-x-auto rounded-full border p-1.5 backdrop-blur-xl"
    aria-label="Main"
  >
    <a href="/" class="rounded-full px-3.5 py-2 text-sm font-semibold whitespace-nowrap">
      {site.name.toLowerCase().replace(" ", "")}
    </a>
    <div class="hidden items-center md:flex">
      {sections.map((section) => (
        <a
          href={`/#${section.id}`}
          class="rounded-full px-3.5 py-2 text-sm whitespace-nowrap transition-colors hover:bg-black/5 dark:hover:bg-white/10"
        >
          {section.label}
        </a>
      ))}
      <a
        href="/now"
        class="rounded-full px-3.5 py-2 text-sm whitespace-nowrap transition-colors hover:bg-black/5 dark:hover:bg-white/10"
      >
        Now
      </a>
    </div>
    <button
      type="button"
      data-palette-open
      class="hidden rounded-full px-3 py-2 font-mono text-xs text-ink-soft transition-colors hover:bg-black/5 sm:inline-flex dark:text-chalk-soft dark:hover:bg-white/10"
      aria-label="Open command palette, Ctrl K"
    >
      Ctrl K
    </button>
    <ThemeToggle />
    <a href="/#contact" class="btn-dark !px-4 !py-2 text-sm whitespace-nowrap">
      Say hi
    </a>
  </nav>
</header>

<style>
  .pill {
    background: rgba(255, 255, 255, 0.75);
    border-color: var(--edge);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translate(var(--nx, 0px), var(--ny, 0px));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    scrollbar-width: none;
  }

  :global(.dark) .pill {
    background: rgba(26, 26, 24, 0.75);
  }
</style>

<script>
  const pill = document.querySelector<HTMLElement>("[data-nav] nav");
  const fine = window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)");

  if (pill && fine.matches) {
    window.addEventListener(
      "pointermove",
      (e) => {
        pill.style.setProperty("--nx", `${(e.clientX / innerWidth - 0.5) * 8}px`);
        pill.style.setProperty("--ny", `${Math.max(0, 1 - e.clientY / 160) * -6}px`);
      },
      { passive: true },
    );
  }
</script>
