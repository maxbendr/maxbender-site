---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../lib/content";

interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-transparent bg-paper/80 backdrop-blur-md transition-colors duration-300 dark:bg-night/80"
  data-nav
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-6"
    aria-label="Main"
  >
    <a
      href="/"
      class="font-mono text-sm tracking-tight transition-colors hover:text-accent dark:hover:text-accent-dark"
    >
      {site.name.toLowerCase().replace(" ", "")}
    </a>

    <div class="flex items-center gap-1 sm:gap-3">
      <div class="hidden items-center gap-5 text-sm text-ink-soft md:flex dark:text-chalk-soft">
        {sections.map((section) => (
          <a
            href={`/#${section.id}`}
            class="transition-colors hover:text-accent dark:hover:text-accent-dark"
          >
            {section.label}
          </a>
        ))}
        <a href="/now" class="transition-colors hover:text-accent dark:hover:text-accent-dark">
          Now
        </a>
      </div>
      <button
        type="button"
        data-palette-open
        class="edge inline-flex items-center gap-2 rounded-full border px-3 py-1.5 font-mono text-xs text-ink-soft transition-colors hover:border-accent hover:text-accent dark:text-chalk-soft dark:hover:border-accent-dark dark:hover:text-accent-dark"
        aria-label="Open command palette, Ctrl K"
      >
        <span>Ctrl K</span>
      </button>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle("border-b", window.scrollY > 8);
    nav.style.borderColor = window.scrollY > 8 ? "var(--edge)" : "transparent";
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
