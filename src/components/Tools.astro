---
import { tools } from "../lib/content";

const row = [...tools.tools, ...tools.tools];
---

<section id="tools" class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="reveal text-center">
    <p class="eyebrow">{tools.label}</p>
    <h2 class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">{tools.title}</h2>
  </div>
  <div class="marquee reveal mt-10" aria-label={tools.label}>
    <ul class="track">
      {row.map((tool, i) => (
        <li aria-hidden={i >= tools.tools.length ? "true" : undefined}>
          <img
            src={tool.logo}
            alt={tool.name}
            title={tool.name}
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    gap: 3.5rem;
    padding: 0.5rem 0;
    animation: slide 40s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .track li {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
  }

  .track img {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.3s,
      opacity 0.3s,
      transform 0.3s;
  }

  :global(.dark) .track img {
    filter: grayscale(1) invert(1);
  }

  .track li:hover img {
    filter: none;
    opacity: 1;
    transform: scale(1.15);
  }

  :global(.dark) .track li:hover img {
    filter: invert(1);
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }

    .track li[aria-hidden] {
      display: none;
    }
  }
</style>
