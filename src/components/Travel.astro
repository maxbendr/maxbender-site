---
import { createRequire } from "node:module";
import { readFileSync } from "node:fs";
import { geoNaturalEarth1, geoPath, type GeoProjection } from "d3-geo";
import { feature } from "topojson-client";
import type { Topology } from "topojson-specification";
import type { FeatureCollection, Geometry } from "geojson";
import Section from "./Section.astro";
import { travel } from "../lib/content";

const require = createRequire(import.meta.url);
const topology = JSON.parse(
  readFileSync(require.resolve("world-atlas/countries-110m.json"), "utf8"),
) as Topology;

const countries = feature(
  topology,
  topology.objects.countries,
) as unknown as FeatureCollection<Geometry>;

const width = 960;
const height = 500;

const projection: GeoProjection = geoNaturalEarth1().fitExtent(
  [
    [8, 8],
    [width - 8, height - 8],
  ],
  countries,
);
const path = geoPath(projection);

const landPaths = countries.features
  .map((country) => path(country))
  .filter((d): d is string => Boolean(d));

const pins = travel.places.map((place) => {
  const point = projection([place.lng, place.lat]);
  return { ...place, x: point?.[0] ?? 0, y: point?.[1] ?? 0 };
});
---

<Section id="travel" label="Travel" title="Field notes from the road." intro={travel.intro}>
  <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]" data-travel>
    <div class="edge overflow-hidden rounded-2xl border bg-paper-soft dark:bg-night-soft">
      <svg
        viewBox={`0 0 ${width} ${height}`}
        class="h-auto w-full"
        role="img"
        aria-label="World map with the places I have worked"
      >
        <g class="text-ink/10 dark:text-chalk/10">
          {landPaths.map((d) => (
            <path
              d={d}
              fill="currentColor"
              stroke="var(--edge)"
              stroke-width="0.5"
              vector-effect="non-scaling-stroke"
            />
          ))}
        </g>
        <g>
          {pins.map((pin, index) => (
            <g
              class="cursor-pointer"
              data-pin={String(index)}
              tabindex="0"
              role="button"
              aria-label={`${pin.city}, ${pin.country}`}
            >
              <circle cx={pin.x} cy={pin.y} r="14" fill="transparent" />
              <circle
                cx={pin.x}
                cy={pin.y}
                r="5"
                class="fill-accent transition-all duration-200 dark:fill-accent-dark"
                data-pin-dot
              />
              <text
                x={pin.x + 10}
                y={pin.y + 4}
                class="fill-ink-soft dark:fill-chalk-soft"
                font-size="13"
                font-family="ui-monospace, monospace"
              >
                {pin.city}
              </text>
            </g>
          ))}
        </g>
      </svg>
    </div>

    <div class="edge rounded-2xl border p-6 sm:p-8" data-travel-panel>
      <p class="font-mono text-xs uppercase tracking-[0.2em] accent" data-panel-country>
        {pins[0]?.country}
      </p>
      <h3 class="mt-3 text-2xl font-semibold tracking-tight" data-panel-city>
        {pins[0]?.city}
      </h3>
      <p class="mt-3 text-ink-soft dark:text-chalk-soft" data-panel-note>
        {pins[0]?.note}
      </p>
      <a
        class="link-underline mt-4 text-sm"
        style="display:none"
        data-panel-link
        href="#travel"
        target="_blank"
        rel="noopener"
      >
        Read the post
      </a>
      <p class="mt-6 font-mono text-xs text-ink-soft dark:text-chalk-soft">
        Click a pin. {pins.length} places so far.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ places: pins }}>
    (() => {
      const panel = document.querySelector("[data-travel-panel]");
      if (!panel) return;

      const country = panel.querySelector("[data-panel-country]");
      const city = panel.querySelector("[data-panel-city]");
      const note = panel.querySelector("[data-panel-note]");
      const link = panel.querySelector("[data-panel-link]");
      const pinNodes = Array.from(document.querySelectorAll("[data-pin]"));

      const select = (index) => {
        const place = places[index];
        if (!place) return;
        if (country) country.textContent = place.country;
        if (city) city.textContent = place.city;
        if (note) note.textContent = place.note;
        if (link) {
          link.setAttribute("href", place.url || "#travel");
          link.style.display = place.url ? "inline-flex" : "none";
        }
        pinNodes.forEach((node, i) => {
          const dot = node.querySelector("[data-pin-dot]");
          if (dot) dot.setAttribute("r", i === index ? "8" : "5");
        });
      };

      pinNodes.forEach((node, index) => {
        node.addEventListener("click", () => select(index));
        node.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            select(index);
          }
        });
      });

      select(0);
    })();
  </script>
</Section>
