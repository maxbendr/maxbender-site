---
import "leaflet/dist/leaflet.css";
import Section from "./Section.astro";
import { travel } from "../lib/content";

const first = travel.places[0];
---

<Section id="travel" label={travel.label} title={travel.title} intro={travel.intro}>
  <div class="reveal grid items-stretch gap-6 lg:grid-cols-[1.4fr_1fr]" data-travel>
    <div
      class="map edge h-[22rem] overflow-hidden rounded-3xl border lg:h-[34rem]"
      data-map
      data-places={JSON.stringify(travel.places.map((p) => [p.lat, p.lng, p.city]))}
      role="region"
      aria-label="World map with the places I have worked. Use the city buttons to pick one."
    ></div>

    <div class="card flex flex-col overflow-hidden !rounded-3xl !transition-none hover:!translate-y-0 hover:!shadow-none">
      <div class="photo aspect-video" data-photo>
        <img
          src={first?.image}
          alt=""
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
          style={first?.image ? "" : "display:none"}
          data-photo-img
        />
        <div class="ph" data-photo-ph style={first?.image ? "display:none" : ""}>
          [PLACEHOLDER] photo from {first?.city}
        </div>
      </div>
      <div class="flex flex-1 flex-col p-6 sm:p-7" data-body aria-live="polite">
        <p class="eyebrow" data-kind>
          {first?.kind} · {first?.country}
        </p>
        <h3 class="mt-2 text-3xl font-semibold tracking-tight" data-city>
          {first?.city}
        </h3>
        <p class="mt-3 text-ink-soft dark:text-chalk-soft" data-note>
          {first?.note}
        </p>
        <ul class="mt-5 space-y-2.5 text-sm" data-items>
          {first?.items.map((item) => (
            <li class="edge border-t pt-2.5">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 lg:col-span-2" role="tablist" aria-label="Cities">
      {travel.places.map((p, i) => (
        <button
          type="button"
          role="tab"
          class="chip"
          data-city-btn={i}
          aria-selected={i === 0 ? "true" : "false"}
        >
          {p.city}
        </button>
      ))}
    </div>
  </div>

  <template data-places-json>{JSON.stringify(travel.places)}</template>
</Section>

<style>
  .map {
    background: #eceae6;
    filter: saturate(0.6);
  }

  :global(.dark) .map {
    filter: saturate(0.4) invert(0.92) hue-rotate(180deg);
  }

  .map :global(.leaflet-container) {
    font: inherit;
    background: transparent;
  }

  .map :global(.pin) {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 6px rgba(var(--accent-rgb), 0.18);
    cursor: pointer;
    transition: transform 0.3s;
  }

  .map :global(.pin.on) {
    transform: scale(1.5);
    box-shadow: 0 0 0 10px rgba(var(--accent-rgb), 0.25);
  }

  .map :global(.pin::after) {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    animation: pulse 2.4s ease-out infinite;
  }

  .photo {
    background: linear-gradient(135deg, #ececea, #d8d8d4);
    overflow: hidden;
  }

  .ph {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 0.85rem;
    color: #888;
  }

  .fade {
    animation: fade 0.5s;
  }

  .chip {
    border: 1px solid var(--edge);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    background: transparent;
    color: inherit;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .chip[aria-selected="true"] {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }

  :global(.dark) .chip[aria-selected="true"] {
    background: var(--color-chalk);
    color: var(--color-ink);
    border-color: var(--color-chalk);
  }

  @keyframes pulse {
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  import L from "leaflet";
  import type { Place } from "../lib/content";

  const root = document.querySelector<HTMLElement>("[data-travel]");
  const mapEl = document.querySelector<HTMLElement>("[data-map]");
  const json = document.querySelector<HTMLTemplateElement>("[data-places-json]");

  if (root && mapEl && json) {
    const places = JSON.parse(json.innerHTML) as Place[];
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel);

    const map = L.map(mapEl, {
      zoomControl: false,
      attributionControl: true,
      scrollWheelZoom: false,
      worldCopyJump: true,
    }).setView([30, 20], 2);
    map.attributionControl.setPrefix(false);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 8, attribution: "Esri" },
    ).addTo(map);

    const pins = places.map((p, i) =>
      L.marker([p.lat, p.lng], {
        icon: L.divIcon({ className: "", html: `<div class="pin" aria-hidden="true"></div>` }),
        keyboard: false,
        title: p.city,
      })
        .addTo(map)
        .on("click", () => show(i)),
    );
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-city-btn]")];
    chips.forEach((c, i) => c.addEventListener("click", () => show(i)));

    function show(i: number) {
      const p = places[i];
      if (!p) return;
      pins.forEach((m, j) =>
        m
          .getElement()
          ?.querySelector(".pin")
          ?.classList.toggle("on", i === j),
      );
      chips.forEach((c, j) => c.setAttribute("aria-selected", String(i === j)));

      const body = q<HTMLElement>("[data-body]");
      if (body) {
        body.classList.remove("fade");
        void body.offsetWidth;
        body.classList.add("fade");
      }
      q<HTMLElement>("[data-kind]")!.textContent = `${p.kind} · ${p.country}`;
      q<HTMLElement>("[data-city]")!.textContent = p.city;
      q<HTMLElement>("[data-note]")!.textContent = p.note;
      q<HTMLElement>("[data-items]")!.replaceChildren(
        ...p.items.map((text) => {
          const li = document.createElement("li");
          li.className = "edge border-t pt-2.5";
          li.textContent = text;
          return li;
        }),
      );

      const img = q<HTMLImageElement>("[data-photo-img]")!;
      const ph = q<HTMLElement>("[data-photo-ph]")!;
      img.style.display = p.image ? "" : "none";
      ph.style.display = p.image ? "none" : "";
      ph.textContent = `[PLACEHOLDER] photo from ${p.city}`;
      if (p.image) img.src = p.image;

      if (still.matches) map.setView([p.lat, p.lng], 3);
      else map.flyTo([p.lat, p.lng], 3, { duration: 1.2 });
    }

    show(0);
  }
</script>
