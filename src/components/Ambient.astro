---
/* Site-wide atmosphere: two slow color fields behind the page and a soft cursor for fine pointers. */
---

<div class="ambient" aria-hidden="true">
  <div class="ambient-blob ambient-a"></div>
  <div class="ambient-blob ambient-b"></div>
</div>
<div class="cursor" aria-hidden="true" data-cursor>
  <div class="cursor-dot"></div>
  <div class="cursor-ring"></div>
</div>

<style is:global>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient-blob {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.1;
    will-change: transform;
  }

  .dark .ambient-blob {
    opacity: 0.14;
  }

  .ambient-a {
    top: -30vmax;
    left: -20vmax;
    background: radial-gradient(circle, var(--color-accent), transparent 65%);
    animation: ambient-a 40s ease-in-out infinite alternate;
  }

  .ambient-b {
    right: -25vmax;
    bottom: -35vmax;
    background: radial-gradient(circle, #5b6cff, transparent 65%);
    animation: ambient-b 50s ease-in-out infinite alternate;
  }

  @keyframes ambient-a {
    to {
      transform: translate3d(25vw, 30vh, 0) scale(1.2);
    }
  }

  @keyframes ambient-b {
    to {
      transform: translate3d(-20vw, -30vh, 0) scale(0.85);
    }
  }

  .cursor {
    display: none;
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .has-cursor,
    .has-cursor a,
    .has-cursor button,
    .has-cursor summary,
    .has-cursor label {
      cursor: none;
    }

    .has-cursor .cursor {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .has-cursor .cursor.is-on {
      opacity: 1;
    }

    .cursor-dot,
    .cursor-ring {
      position: absolute;
      top: 0;
      left: 0;
      border-radius: 50%;
      translate: -50% -50%;
    }

    .cursor-dot {
      width: 6px;
      height: 6px;
      background: var(--color-accent);
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0);
    }

    .cursor-ring {
      width: 36px;
      height: 36px;
      border: 1px solid var(--color-accent);
      opacity: 0.6;
      transform: translate3d(var(--rx, 0px), var(--ry, 0px), 0) scale(var(--s, 1));
      transition: scale 0.25s;
    }

    .dark .cursor-dot {
      background: var(--color-accent-dark);
    }

    .dark .cursor-ring {
      border-color: var(--color-accent-dark);
    }

    .cursor.is-hover .cursor-ring {
      --s: 1.6;
      opacity: 0.9;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>("[data-cursor]");
  const fine = window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)");

  if (cursor && fine.matches) {
    document.documentElement.classList.add("has-cursor");
    let x = 0;
    let y = 0;
    let rx = 0;
    let ry = 0;
    let raf = 0;

    const tick = () => {
      rx += (x - rx) * 0.18;
      ry += (y - ry) * 0.18;
      cursor.style.setProperty("--rx", `${rx}px`);
      cursor.style.setProperty("--ry", `${ry}px`);
      if (Math.abs(x - rx) > 0.2 || Math.abs(y - ry) > 0.2) raf = requestAnimationFrame(tick);
      else raf = 0;
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        x = e.clientX;
        y = e.clientY;
        cursor.style.setProperty("--x", `${x}px`);
        cursor.style.setProperty("--y", `${y}px`);
        cursor.classList.add("is-on");
        cursor.classList.toggle(
          "is-hover",
          Boolean((e.target as Element | null)?.closest("a, button, summary, label")),
        );
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
    document.documentElement.addEventListener("pointerleave", () =>
      cursor.classList.remove("is-on"),
    );

    fine.addEventListener("change", (e) => {
      if (!e.matches) {
        document.documentElement.classList.remove("has-cursor");
        cursor.classList.remove("is-on");
      }
    });
  }
</script>
