---
/* Site-wide atmosphere: faint column grid, two slow color fields, a soft cursor for fine pointers. */
---

<div class="ambient" aria-hidden="true">
  <div class="ambient-grid"></div>
  <div class="ambient-blob ambient-a"></div>
  <div class="ambient-blob ambient-b"></div>
</div>
<div class="cursor" aria-hidden="true" data-cursor>
  <div class="cursor-dot"></div>
  <div class="cursor-ring"></div>
</div>

<style is:global>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      90deg,
      var(--edge) 0 1px,
      transparent 1px calc(100% / 6)
    );
    background-size: calc(100% - 3rem) 100%;
    background-position: 1.5rem 0;
    opacity: 0.8;
    transition: opacity 0.6s;
  }

  .ambient-blob {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
    will-change: transform;
    transition: opacity 0.6s;
  }

  .dark .ambient-blob {
    opacity: 0.18;
  }

  .ambient-a {
    top: -35vmax;
    left: -20vmax;
    background: radial-gradient(circle, #c9d2ff, transparent 65%);
    animation: ambient-a 40s ease-in-out infinite alternate;
  }

  .ambient-b {
    right: -25vmax;
    bottom: -40vmax;
    background: radial-gradient(circle, #ffd9c7, transparent 65%);
    animation: ambient-b 50s ease-in-out infinite alternate;
  }

  .at-edge .ambient-grid {
    opacity: 0.2;
  }

  .at-edge .ambient-blob {
    opacity: 0.1;
  }

  @keyframes ambient-a {
    to {
      transform: translate3d(25vw, 30vh, 0) scale(1.15);
    }
  }

  @keyframes ambient-b {
    to {
      transform: translate3d(-20vw, -25vh, 0) scale(0.9);
    }
  }

  .cursor {
    display: none;
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .has-cursor,
    .has-cursor a,
    .has-cursor button,
    .has-cursor summary,
    .has-cursor label {
      cursor: none;
    }

    .has-cursor .cursor {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
      mix-blend-mode: multiply;
    }

    .dark .has-cursor .cursor,
    .has-cursor.dark .cursor {
      mix-blend-mode: screen;
    }

    .has-cursor .cursor.is-on {
      opacity: 1;
    }

    .cursor-dot,
    .cursor-ring {
      position: absolute;
      top: 0;
      left: 0;
      border-radius: 50%;
      translate: -50% -50%;
    }

    .cursor-dot {
      width: 5px;
      height: 5px;
      background: var(--color-accent);
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0);
    }

    .cursor-ring {
      width: 34px;
      height: 34px;
      border: 1px solid var(--color-accent);
      transform: translate3d(var(--rx, 0px), var(--ry, 0px), 0) scale(var(--s, 1));
      transition: scale 0.25s;
    }

    .dark .cursor-dot {
      background: var(--color-accent-dark);
    }

    .dark .cursor-ring {
      border-color: var(--color-accent-dark);
    }

    .cursor.is-hover .cursor-ring {
      --s: 1.7;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>("[data-cursor]");
  const fine = window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)");

  window.addEventListener(
    "pointermove",
    (e) => {
      const m = Math.min(e.clientX, e.clientY, innerWidth - e.clientX, innerHeight - e.clientY);
      document.body.classList.toggle("at-edge", m < 70);
    },
    { passive: true },
  );
  document.documentElement.addEventListener("pointerleave", () =>
    document.body.classList.remove("at-edge"),
  );

  if (cursor && fine.matches) {
    document.documentElement.classList.add("has-cursor");
    let x = 0;
    let y = 0;
    let rx = 0;
    let ry = 0;
    let raf = 0;

    const tick = () => {
      rx += (x - rx) * 0.18;
      ry += (y - ry) * 0.18;
      cursor.style.setProperty("--rx", `${rx}px`);
      cursor.style.setProperty("--ry", `${ry}px`);
      if (Math.abs(x - rx) > 0.2 || Math.abs(y - ry) > 0.2) raf = requestAnimationFrame(tick);
      else raf = 0;
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        x = e.clientX;
        y = e.clientY;
        cursor.style.setProperty("--x", `${x}px`);
        cursor.style.setProperty("--y", `${y}px`);
        cursor.classList.add("is-on");
        cursor.classList.toggle(
          "is-hover",
          Boolean((e.target as Element | null)?.closest("a, button, summary, label")),
        );
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
    document.documentElement.addEventListener("pointerleave", () =>
      cursor.classList.remove("is-on"),
    );

    fine.addEventListener("change", (e) => {
      if (!e.matches) {
        document.documentElement.classList.remove("has-cursor");
        cursor.classList.remove("is-on");
      }
    });
  }
</script>
