---
import Game from "../../layouts/Game.astro";

const ROWS = 8;
const COLS = 5;
const keyboard = ["qwertyuiop", "asdfghjkl", "zxcvbnm"];
---

<Game
  name="Tally"
  tagline="Wordle without the colours."
  description="Guess the five-letter word. You are only told how many letters are right, never which ones."
>
  <div class="mt-8 flex flex-col items-center" data-game>
    <div class="flex w-full max-w-sm items-center justify-between gap-3">
      <div class="edge inline-flex rounded-full border p-0.5 font-mono text-xs" role="tablist">
        <button
          type="button"
          role="tab"
          data-mode="daily"
          class="rounded-full px-3 py-1.5 transition-colors data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:bg-chalk dark:data-[active=true]:text-night"
        >
          Daily
        </button>
        <button
          type="button"
          role="tab"
          data-mode="endless"
          class="rounded-full px-3 py-1.5 transition-colors data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:bg-chalk dark:data-[active=true]:text-night"
        >
          Endless
        </button>
      </div>
      <p
        class="font-mono text-xs text-ink-soft dark:text-chalk-soft"
        data-puzzle-label
        aria-live="polite"
      ></p>
    </div>

    <div class="mt-6 w-full max-w-sm space-y-1.5" data-board>
      {Array.from({ length: ROWS }).map((_, row) => (
        <div class="flex items-center gap-1.5" data-row={String(row)}>
          <div class="flex flex-1 gap-1.5">
            {Array.from({ length: COLS }).map((__, col) => (
              <div
                data-tile={String(col)}
                class="edge flex aspect-square flex-1 items-center justify-center rounded-lg border text-xl font-semibold uppercase transition-colors data-[filled=true]:border-ink-soft/50 dark:data-[filled=true]:border-chalk-soft/50"
              />
            ))}
          </div>
          <div
            data-score
            class="flex w-16 shrink-0 items-center justify-end gap-1.5 font-mono text-sm tabular-nums"
          />
        </div>
      ))}
    </div>

    <p
      class="mt-4 h-5 text-center font-mono text-xs text-ink-soft dark:text-chalk-soft"
      data-toast
      role="status"
      aria-live="polite"
    ></p>

    <div class="mt-2 hidden w-full max-w-sm text-center" data-result>
      <p class="text-lg font-semibold tracking-tight" data-result-headline></p>
      <p class="mt-1 text-sm text-ink-soft dark:text-chalk-soft" data-result-note></p>
      <div class="mt-4 flex items-center justify-center gap-2">
        <button
          type="button"
          data-share
          class="rounded-full bg-accent px-4 py-2 font-mono text-xs text-white transition-opacity hover:opacity-90 dark:bg-accent-dark dark:text-night"
        >
          Copy result
        </button>
        <button
          type="button"
          data-again
          class="edge hidden rounded-full border px-4 py-2 font-mono text-xs transition-colors hover:border-accent hover:text-accent dark:hover:border-accent-dark dark:hover:text-accent-dark"
        >
          New word
        </button>
      </div>
      <dl class="mt-6 grid grid-cols-4 gap-2 font-mono text-xs" data-stats>
        <div>
          <dt class="text-ink-soft dark:text-chalk-soft">Played</dt>
          <dd class="mt-1 text-base" data-stat="played">
            0
          </dd>
        </div>
        <div>
          <dt class="text-ink-soft dark:text-chalk-soft">Won</dt>
          <dd class="mt-1 text-base" data-stat="won">
            0
          </dd>
        </div>
        <div>
          <dt class="text-ink-soft dark:text-chalk-soft">Streak</dt>
          <dd class="mt-1 text-base" data-stat="streak">
            0
          </dd>
        </div>
        <div>
          <dt class="text-ink-soft dark:text-chalk-soft">Best</dt>
          <dd class="mt-1 text-base" data-stat="best">
            0
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-6 w-full max-w-sm select-none" data-keyboard>
      <div class="mb-2 flex justify-end">
        <button
          type="button"
          data-notes
          aria-pressed="false"
          class="edge rounded-full border px-3 py-1 font-mono text-[11px] text-ink-soft transition-colors aria-pressed:border-accent aria-pressed:text-accent dark:text-chalk-soft dark:aria-pressed:border-accent-dark dark:aria-pressed:text-accent-dark"
        >
          Notes
        </button>
      </div>
      {keyboard.map((row, index) => (
        <div class="mb-1.5 flex justify-center gap-1.5">
          {index === 2 && (
            <button
              type="button"
              data-key="enter"
              class="edge flex-[1.6] rounded-lg border py-3 font-mono text-[11px] uppercase transition-colors hover:border-accent hover:text-accent dark:hover:border-accent-dark dark:hover:text-accent-dark"
            >
              Enter
            </button>
          )}
          {row.split("").map((letter) => (
            <button
              type="button"
              data-key={letter}
              class="edge flex-1 rounded-lg border py-3 font-mono text-sm uppercase transition-colors hover:border-accent hover:text-accent data-[out=true]:text-ink-soft/40 data-[out=true]:line-through dark:hover:border-accent-dark dark:hover:text-accent-dark dark:data-[out=true]:text-chalk-soft/40"
            >
              {letter}
            </button>
          ))}
          {index === 2 && (
            <button
              type="button"
              data-key="backspace"
              aria-label="Backspace"
              class="edge flex-[1.6] rounded-lg border py-3 font-mono text-[11px] uppercase transition-colors hover:border-accent hover:text-accent dark:hover:border-accent-dark dark:hover:text-accent-dark"
            >
              Del
            </button>
          )}
        </div>
      ))}
    </div>

    <details class="edge mt-10 w-full max-w-sm rounded-2xl border p-5 text-sm">
      <summary class="cursor-pointer font-medium">How to play</summary>
      <div class="mt-3 space-y-3 leading-relaxed text-ink-soft dark:text-chalk-soft">
        <p>
          Guess the hidden five-letter word in eight tries. After each guess you get two numbers
          and nothing else:
        </p>
        <ul class="space-y-1.5">
          <li class="flex items-center gap-2">
            <span class="inline-block size-3 shrink-0 rounded-full bg-emerald-500"></span>
            right letter, right place
          </li>
          <li class="flex items-center gap-2">
            <span class="inline-block size-3 shrink-0 rounded-full border-2 border-amber-500 bg-transparent"></span>
            right letter, wrong place
          </li>
        </ul>
        <p>
          You are never told <em>which</em> letters those are. That is the whole game: it is
          Wordle crossed with Mastermind, so you have to deduce positions yourself. Use{" "}
          <strong>Notes</strong> to strike out letters you have ruled out.
        </p>
        <p>
          Daily gives everyone the same word. Endless gives you a new one whenever you want.
        </p>
      </div>
    </details>
  </div>
</Game>

<script>
  import words from "../../../content/games/tally-words.json";

  const ANSWERS = words.answers.split(" ");
  const ALLOWED = new Set([...words.allowed.split(" "), ...ANSWERS]);

  const ROWS = 8;
  const COLS = 5;
  const EPOCH = Date.UTC(2026, 0, 1);
  const STATS_KEY = "tally:stats";

  type Mode = "daily" | "endless";
  type Status = "playing" | "won" | "lost";
  interface Stats {
    played: number;
    won: number;
    streak: number;
    best: number;
    lastPuzzle: number;
  }

  const root = document.querySelector<HTMLElement>("[data-game]");
  if (root) {
    const board = root.querySelector<HTMLElement>("[data-board]")!;
    const toast = root.querySelector<HTMLElement>("[data-toast]")!;
    const puzzleLabel = root.querySelector<HTMLElement>("[data-puzzle-label]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const headline = root.querySelector<HTMLElement>("[data-result-headline]")!;
    const note = root.querySelector<HTMLElement>("[data-result-note]")!;
    const shareButton = root.querySelector<HTMLButtonElement>("[data-share]")!;
    const againButton = root.querySelector<HTMLButtonElement>("[data-again]")!;
    const notesButton = root.querySelector<HTMLButtonElement>("[data-notes]")!;
    const rows = Array.from(board.querySelectorAll<HTMLElement>("[data-row]"));
    const keys = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-key]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let mode: Mode = "daily";
    let secret = "";
    let puzzle = 0;
    let guesses: string[] = [];
    let current = "";
    let status: Status = "playing";
    let notesMode = false;
    let toastTimer = 0;

    const puzzleNumber = () =>
      Math.floor(
        (Date.UTC(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()) -
          EPOCH) /
          86400000,
      );

    const read = <T,>(key: string, fallback: T): T => {
      try {
        const raw = localStorage.getItem(key);
        return raw ? (JSON.parse(raw) as T) : fallback;
      } catch {
        return fallback;
      }
    };

    const write = (key: string, value: unknown) => {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        /* private mode: play without history */
      }
    };

    const stats = (): Stats =>
      read<Stats>(STATS_KEY, { played: 0, won: 0, streak: 0, best: 0, lastPuzzle: -1 });

    const score = (guess: string) => {
      let exact = 0;
      const pool: Record<string, number> = {};
      const rest: string[] = [];
      for (let i = 0; i < COLS; i += 1) {
        if (guess[i] === secret[i]) exact += 1;
        else {
          pool[secret[i]] = (pool[secret[i]] ?? 0) + 1;
          rest.push(guess[i]);
        }
      }
      let present = 0;
      for (const letter of rest) {
        if (pool[letter] > 0) {
          pool[letter] -= 1;
          present += 1;
        }
      }
      return { exact, present };
    };

    const say = (message: string) => {
      toast.textContent = message;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.textContent = "";
      }, 2000);
    };

    const paintRow = (index: number) => {
      const row = rows[index];
      const tiles = row.querySelectorAll<HTMLElement>("[data-tile]");
      const word =
        index < guesses.length ? guesses[index] : index === guesses.length ? current : "";
      tiles.forEach((tile, col) => {
        tile.textContent = word[col] ?? "";
        tile.dataset.filled = word[col] ? "true" : "false";
      });

      const slot = row.querySelector<HTMLElement>("[data-score]")!;
      slot.textContent = "";
      if (index >= guesses.length) {
        slot.removeAttribute("aria-label");
        return;
      }

      const { exact, present } = score(guesses[index]);
      slot.setAttribute("aria-label", `${exact} exact, ${present} misplaced`);
      const chip = (count: number, kind: "exact" | "present") => {
        const span = document.createElement("span");
        span.className = "flex items-center gap-1";
        const dot = document.createElement("span");
        dot.className =
          kind === "exact"
            ? "inline-block size-2.5 rounded-full bg-emerald-500"
            : "inline-block size-2.5 rounded-full border-2 border-amber-500";
        const label = document.createElement("span");
        label.textContent = String(count);
        if (count === 0) span.classList.add("opacity-30");
        span.append(dot, label);
        return span;
      };
      slot.append(chip(exact, "exact"), chip(present, "present"));
    };

    const paint = () => {
      for (let i = 0; i < ROWS; i += 1) paintRow(i);
    };

    const shareText = () => {
      const header = mode === "daily" ? `Tally #${puzzle}` : "Tally";
      const tally = status === "won" ? `${guesses.length}/${ROWS}` : `X/${ROWS}`;
      const grid = guesses
        .map((guess) => {
          const { exact, present } = score(guess);
          return (
            "🟩".repeat(exact) + "🟨".repeat(present) + "⬜".repeat(COLS - exact - present)
          );
        })
        .join("\n");
      return `${header} ${tally}\n${grid}\nmaxbender.com/games/tally`;
    };

    const renderStats = () => {
      const s = stats();
      const map: Record<string, number> = {
        played: s.played,
        won: s.won,
        streak: s.streak,
        best: s.best,
      };
      root.querySelectorAll<HTMLElement>("[data-stat]").forEach((cell) => {
        cell.textContent = String(map[cell.dataset.stat ?? ""] ?? 0);
      });
    };

    const finish = () => {
      result.classList.remove("hidden");
      headline.textContent =
        status === "won"
          ? ["Sharp.", "Clean.", "Deduced.", "Got it."][Math.min(guesses.length - 1, 3)]
          : secret.toUpperCase();
      note.textContent =
        status === "won"
          ? `${secret.toUpperCase()} in ${guesses.length} ${guesses.length === 1 ? "guess" : "guesses"}.`
          : "Out of guesses.";
      againButton.classList.toggle("hidden", mode !== "endless");
      renderStats();
    };

    const recordDaily = () => {
      const s = stats();
      if (s.lastPuzzle === puzzle) return;
      s.played += 1;
      if (status === "won") {
        s.streak = s.lastPuzzle === puzzle - 1 ? s.streak + 1 : 1;
        s.won += 1;
        s.best = Math.max(s.best, s.streak);
      } else {
        s.streak = 0;
      }
      s.lastPuzzle = puzzle;
      write(STATS_KEY, s);
    };

    const submit = () => {
      if (status !== "playing") return;
      if (current.length < COLS) {
        say("Five letters.");
        return;
      }
      if (!ALLOWED.has(current)) {
        say("Not a word I know.");
        return;
      }
      guesses.push(current);
      current = "";
      if (guesses[guesses.length - 1] === secret) status = "won";
      else if (guesses.length >= ROWS) status = "lost";
      paint();
      if (mode === "daily") {
        write(`tally:daily:${puzzle}`, { guesses, status });
        if (status !== "playing") recordDaily();
      }
      if (status !== "playing") window.setTimeout(finish, reduceMotion ? 0 : 250);
    };

    const type = (letter: string) => {
      if (status !== "playing" || current.length >= COLS) return;
      current += letter;
      paintRow(guesses.length);
    };

    const backspace = () => {
      if (status !== "playing" || !current) return;
      current = current.slice(0, -1);
      paintRow(guesses.length);
    };

    const start = (next: Mode) => {
      mode = next;
      guesses = [];
      current = "";
      status = "playing";
      result.classList.add("hidden");
      toast.textContent = "";
      keys.forEach((key) => delete key.dataset.out);

      if (mode === "daily") {
        puzzle = puzzleNumber();
        secret = ANSWERS[((puzzle % ANSWERS.length) + ANSWERS.length) % ANSWERS.length];
        const saved = read<{ guesses: string[]; status: Status } | null>(
          `tally:daily:${puzzle}`,
          null,
        );
        if (saved) {
          guesses = saved.guesses;
          status = saved.status;
        }
        puzzleLabel.textContent = `#${puzzle}`;
      } else {
        secret = ANSWERS[Math.floor(Math.random() * ANSWERS.length)];
        puzzleLabel.textContent = "free play";
      }

      root.querySelectorAll<HTMLElement>("[data-mode]").forEach((tab) => {
        tab.dataset.active = String(tab.dataset.mode === mode);
        tab.setAttribute("aria-selected", String(tab.dataset.mode === mode));
      });

      paint();
      if (status !== "playing") finish();
    };

    root.querySelectorAll<HTMLElement>("[data-mode]").forEach((tab) => {
      tab.addEventListener("click", () => start(tab.dataset.mode as Mode));
    });

    keys.forEach((key) => {
      key.addEventListener("click", () => {
        const value = key.dataset.key!;
        if (value === "enter") submit();
        else if (value === "backspace") backspace();
        else if (notesMode) key.dataset.out = key.dataset.out === "true" ? "false" : "true";
        else type(value);
      });
    });

    notesButton.addEventListener("click", () => {
      notesMode = !notesMode;
      notesButton.setAttribute("aria-pressed", String(notesMode));
      say(notesMode ? "Tap letters to rule them out." : "");
    });

    againButton.addEventListener("click", () => start("endless"));

    shareButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareText());
        say("Copied.");
      } catch {
        say("Copy failed.");
      }
    });

    window.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (target && ["INPUT", "TEXTAREA"].includes(target.tagName)) return;
      if (event.key === "Enter") {
        if (
          target?.closest("[data-key], [data-mode], [data-notes], [data-share], [data-again]")
        )
          return;
        submit();
      } else if (event.key === "Backspace") backspace();
      else if (/^[a-zA-Z]$/.test(event.key)) type(event.key.toLowerCase());
    });

    start("daily");
  }
</script>
