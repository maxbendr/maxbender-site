---
import Game from "../../layouts/Game.astro";
---

<Game
  name="Traffic"
  tagline="One intersection, one button, four queues of impatient drivers."
  description="Switch the lights to keep traffic moving. Let a driver wait too long and they give up on you. Ambulances do not wait at all."
>
  <div class="mt-8 flex w-full flex-col items-center" data-game>
    <div class="w-full max-w-sm">
      <div class="font-mono text-xs">
        <p data-status class="text-sm text-ink dark:text-chalk"></p>
        <p class="mt-1 text-ink-soft dark:text-chalk-soft">
          <span data-score>0</span> pts &middot; <span data-combo>x1</span> &middot;{" "}
          <span data-lives></span>
        </p>
      </div>

      <div class="edge relative mt-2 overflow-hidden rounded-2xl border">
        <canvas
          data-canvas
          class="block w-full touch-none"
          aria-label="Traffic intersection"
        ></canvas>
        <p
          class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-3 pt-6 text-center font-mono text-xs text-white"
          data-hud
          aria-live="polite"
        ></p>
      </div>

      <button
        type="button"
        data-switch
        class="edge mt-3 w-full rounded-lg border py-4 font-mono text-xs sm:hidden"
      >
        switch lights
      </button>

      <p class="mt-3 hidden text-center font-mono text-xs text-ink-soft sm:block dark:text-chalk-soft">
        <kbd>space</kbd> or click to switch the lights
      </p>

      <div class="mt-4 hidden text-center" data-summary>
        <p class="text-lg font-semibold tracking-tight" data-summary-headline></p>
        <p class="mt-1 text-sm text-ink-soft dark:text-chalk-soft" data-summary-note></p>
        <button
          type="button"
          data-restart
          class="mt-4 rounded-full bg-accent px-4 py-2 font-mono text-xs text-white transition-opacity hover:opacity-90 dark:bg-accent-dark dark:text-night"
        >
          Open the road
        </button>
      </div>
    </div>

    <details class="edge mt-10 w-full max-w-sm rounded-2xl border p-5 text-sm">
      <summary class="cursor-pointer font-medium">How to play</summary>
      <div class="mt-3 space-y-3 leading-relaxed text-ink-soft dark:text-chalk-soft">
        <p>
          You run the lights at one crossing. One button flips which road gets the green, with a
          short amber and an all-red gap in between &mdash; so switching is never free.
        </p>
        <p>
          Every car that clears the junction pays a point, multiplied by your streak. Cars
          waiting at a red lose patience, shown as the bar shrinking under them. When a driver
          runs out they turn around and leave, costing you one of three lives. Ambulances lose
          patience three times as fast and pay ten times as much.
        </p>
        <p>
          Clear cars without anyone turning red-hot and the multiplier climbs. Traffic keeps
          getting heavier, so the run ends when the third driver gives up on you.
        </p>
      </div>
    </details>
  </div>
</Game>

<script>
  const W = 360;
  const H = 420;
  const CX = W / 2;
  const CY = H / 2;
  /** Distance from the middle of the junction to a stop line. */
  const STOP = 46;
  const LANE = 22;
  const CAR_LEN = 26;
  const SPACING = 34;
  const TOP_SPEED = 1.9;
  const LIVES = 3;
  const AMBER = 40;
  const ALL_RED = 34;
  const MIN_GREEN = 70;
  const BEST_KEY = "traffic:best";
  const COLORS = ["#d8604b", "#e0a13c", "#3f7fb5", "#4d9a6a", "#8a6bbf", "#c9c4bb"];

  type Dir = "n" | "s" | "e" | "w";
  type Phase = "ns" | "ew";
  type Light = "green" | "amber" | "red";

  interface Car {
    dir: Dir;
    /** Distance travelled from the spawn point, in pixels. */
    t: number;
    speed: number;
    patience: number;
    color: string;
    siren: boolean;
    scored: boolean;
    /** Past the stop line on a green, so it finishes crossing whatever the lights do. */
    committed: boolean;
    /** Fed up and leaving the queue. */
    quit: boolean;
  }

  const AXIS: Record<Dir, Phase> = { n: "ns", s: "ns", e: "ew", w: "ew" };

  /** Where the stop line sits along each approach, measured from the spawn point. */
  const STOP_T: Record<Dir, number> = {
    n: CY - STOP + 40,
    s: H + 40 - (CY + STOP),
    e: W + 40 - (CX + STOP),
    w: CX - STOP + 40,
  };

  const place = (dir: Dir, t: number) => {
    if (dir === "n") return { x: CX - LANE, y: -40 + t, a: Math.PI / 2 };
    if (dir === "s") return { x: CX + LANE, y: H + 40 - t, a: -Math.PI / 2 };
    if (dir === "e") return { x: W + 40 - t, y: CY - LANE, a: Math.PI };
    return { x: -40 + t, y: CY + LANE, a: 0 };
  };

  const root = document.querySelector<HTMLElement>("[data-game]");
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d")!;
    const hud = root.querySelector<HTMLElement>("[data-hud]")!;
    const statusLine = root.querySelector<HTMLElement>("[data-status]")!;
    const scoreLabel = root.querySelector<HTMLElement>("[data-score]")!;
    const comboLabel = root.querySelector<HTMLElement>("[data-combo]")!;
    const livesLabel = root.querySelector<HTMLElement>("[data-lives]")!;
    const summary = root.querySelector<HTMLElement>("[data-summary]")!;
    const summaryHeadline = root.querySelector<HTMLElement>("[data-summary-headline]")!;
    const summaryNote = root.querySelector<HTMLElement>("[data-summary-note]")!;
    const restart = root.querySelector<HTMLButtonElement>("[data-restart]")!;
    const switchButton = root.querySelector<HTMLButtonElement>("[data-switch]")!;

    let cars: Car[] = [];
    let phase: Phase = "ns";
    let amber = 0;
    let allRed = 0;
    let sinceSwitch = MIN_GREEN;
    let score = 0;
    let lives = LIVES;
    let combo = 1;
    let cleared = 0;
    let frames = 0;
    let running = false;
    let flash = 0;
    let lastSignal = "";
    const spawnIn: Record<Dir, number> = { n: 40, s: 90, e: 150, w: 220 };

    const resize = () => {
      const ratio = window.devicePixelRatio || 1;
      canvas.width = W * ratio;
      canvas.height = H * ratio;
      canvas.style.aspectRatio = `${W} / ${H}`;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const lightFor = (dir: Dir): Light => {
      if (allRed > 0 || AXIS[dir] !== phase) return "red";
      return amber > 0 ? "amber" : "green";
    };

    /** Frames between cars on one approach, falling as the shift gets busier. */
    const spawnGap = () => {
      const heat = Math.min(1, frames / 5400);
      return 150 - heat * 88 + Math.random() * (90 - heat * 55);
    };

    const setStatus = () => {
      const road = phase === "ns" ? "north-south" : "east-west";
      const state = allRed > 0 ? "all red" : amber > 0 ? "amber" : "green";
      statusLine.textContent = `${road} ${state}`;
      scoreLabel.textContent = String(score);
      comboLabel.textContent = `x${combo}`;
      livesLabel.textContent = "\u2665".repeat(lives).padEnd(LIVES, "\u00b7");
    };

    const reset = () => {
      cars = [];
      phase = "ns";
      amber = 0;
      allRed = 0;
      sinceSwitch = MIN_GREEN;
      score = 0;
      lives = LIVES;
      combo = 1;
      cleared = 0;
      frames = 0;
      flash = 0;
      spawnIn.n = 40;
      spawnIn.s = 90;
      spawnIn.e = 150;
      spawnIn.w = 220;
      running = true;
      summary.classList.add("hidden");
      setStatus();
    };

    const requestSwitch = () => {
      if (!running || amber > 0 || allRed > 0) return;
      if (sinceSwitch < MIN_GREEN) {
        flash = 20;
        return;
      }
      amber = AMBER;
    };

    const spawn = (dir: Dir) => {
      const queue = cars.filter((car) => car.dir === dir);
      const last = queue.length ? Math.min(...queue.map((car) => car.t)) : Infinity;
      if (last < SPACING) return false;
      const siren = frames > 900 && Math.random() < 0.07;
      cars.push({
        dir,
        t: 0,
        speed: TOP_SPEED,
        patience: 1,
        color: siren ? "#f2f2f2" : COLORS[Math.floor(Math.random() * COLORS.length)],
        siren,
        scored: false,
        committed: false,
        quit: false,
      });
      return true;
    };

    const loseLife = (car: Car) => {
      lives -= 1;
      combo = 1;
      cleared = 0;
      car.quit = true;
      hud.textContent = car.siren ? "The ambulance gave up." : "A driver gave up on you.";
      if (lives <= 0) {
        running = false;
        const best = Math.max(score, Number(localStorage.getItem(BEST_KEY) ?? 0));
        localStorage.setItem(BEST_KEY, String(best));
        summaryHeadline.textContent = `${score} points`;
        summaryNote.textContent =
          best > score ? `Your best shift is ${best}.` : "That is your best shift yet.";
        summary.classList.remove("hidden");
      }
      setStatus();
    };

    const step = () => {
      frames += 1;
      sinceSwitch += 1;
      if (flash > 0) flash -= 1;

      if (amber > 0) {
        amber -= 1;
        if (amber === 0) allRed = ALL_RED;
      } else if (allRed > 0) {
        allRed -= 1;
        if (allRed === 0) {
          phase = phase === "ns" ? "ew" : "ns";
          sinceSwitch = 0;
        }
      }

      (Object.keys(spawnIn) as Dir[]).forEach((dir) => {
        spawnIn[dir] -= 1;
        if (spawnIn[dir] <= 0 && spawn(dir)) spawnIn[dir] = spawnGap();
      });

      (["n", "s", "e", "w"] as Dir[]).forEach((dir) => {
        const queue = cars.filter((car) => car.dir === dir).sort((a, b) => b.t - a.t);
        const light = lightFor(dir);
        queue.forEach((car, index) => {
          const ahead = queue[index - 1];
          let limit = ahead ? ahead.t - SPACING : Infinity;
          if (!car.committed) {
            const line = STOP_T[dir];
            if (light === "green" && car.t >= line - 0.5) car.committed = true;
            else limit = Math.min(limit, line);
          }

          const room = limit - car.t;
          const target =
            room > 60 ? TOP_SPEED : Math.max(0, Math.min(TOP_SPEED, (room - 1) / 24));
          car.speed += (target - car.speed) * 0.18;
          if (car.speed < 0.05) car.speed = 0;
          car.t = Math.min(car.t + car.speed, limit);

          if (car.speed < 0.25 && !car.quit) {
            car.patience -= (car.siren ? 3 : 1) / 900;
            if (car.patience <= 0) loseLife(car);
          }

          if (!car.scored && car.t > STOP_T[dir] + STOP * 2) {
            car.scored = true;
            score += (car.siren ? 10 : 1) * combo;
            cleared += 1;
            if (cleared % 8 === 0) combo = Math.min(5, combo + 1);
            if (car.siren) hud.textContent = `Ambulance through, +${10 * combo}`;
            setStatus();
          }
        });
      });

      cars = cars.filter((car) => car.t < 520 && !car.quit);

      const signal = `${phase}${amber > 0 ? "a" : allRed > 0 ? "r" : "g"}`;
      if (signal !== lastSignal) {
        lastSignal = signal;
        setStatus();
      }
    };

    const drawRoad = () => {
      ctx.fillStyle = "#7d9468";
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = "#6d8459";
      for (let i = 0; i < 26; i += 1) {
        const x = (i * 97) % W;
        const y = (i * 61) % H;
        ctx.fillRect(x, y, 10, 4);
      }

      ctx.fillStyle = "#3c4147";
      ctx.fillRect(CX - 46, 0, 92, H);
      ctx.fillRect(0, CY - 46, W, 92);

      ctx.strokeStyle = "rgba(255,255,255,0.55)";
      ctx.lineWidth = 2;
      ctx.setLineDash([12, 14]);
      ctx.beginPath();
      ctx.moveTo(CX, 0);
      ctx.lineTo(CX, CY - 46);
      ctx.moveTo(CX, CY + 46);
      ctx.lineTo(CX, H);
      ctx.moveTo(0, CY);
      ctx.lineTo(CX - 46, CY);
      ctx.moveTo(CX + 46, CY);
      ctx.lineTo(W, CY);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = "rgba(255,255,255,0.8)";
      ctx.fillRect(CX - 44, CY - STOP, 42, 4);
      ctx.fillRect(CX + 2, CY + STOP - 4, 42, 4);
      ctx.fillRect(CX + STOP - 4, CY - 44, 4, 42);
      ctx.fillRect(CX - STOP, CY + 2, 4, 42);
    };

    const drawLights = () => {
      const heads: [Dir, number, number][] = [
        ["n", CX - 60, CY - 60],
        ["s", CX + 60, CY + 60],
        ["e", CX + 60, CY - 60],
        ["w", CX - 60, CY + 60],
      ];
      heads.forEach(([dir, x, y]) => {
        const light = lightFor(dir);
        ctx.fillStyle = "#23272b";
        ctx.beginPath();
        ctx.roundRect(x - 7, y - 17, 14, 34, 4);
        ctx.fill();
        const lamps: [Light, string, number][] = [
          ["red", "#e5503f", y - 10],
          ["amber", "#eaa93b", y],
          ["green", "#5cc47a", y + 10],
        ];
        lamps.forEach(([which, color, ly]) => {
          const on = light === which;
          ctx.fillStyle = on ? color : "rgba(255,255,255,0.09)";
          ctx.beginPath();
          ctx.arc(x, ly, 4, 0, Math.PI * 2);
          ctx.fill();
          if (on) {
            ctx.globalAlpha = 0.28;
            ctx.beginPath();
            ctx.arc(x, ly, 9, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        });
      });
    };

    const drawCar = (car: Car) => {
      const { x, y, a } = place(car.dir, car.t);
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(a);

      ctx.fillStyle = "rgba(0,0,0,0.22)";
      ctx.beginPath();
      ctx.roundRect(-CAR_LEN / 2 + 2, -7 + 3, CAR_LEN, 15, 4);
      ctx.fill();

      ctx.fillStyle = car.color;
      ctx.beginPath();
      ctx.roundRect(-CAR_LEN / 2, -7, CAR_LEN, 15, 4);
      ctx.fill();

      ctx.fillStyle = "rgba(20,26,32,0.55)";
      ctx.fillRect(-2, -5.5, 9, 12);
      ctx.fillStyle = "rgba(255,255,255,0.35)";
      ctx.fillRect(CAR_LEN / 2 - 4, -6, 3, 4);
      ctx.fillRect(CAR_LEN / 2 - 4, 3, 3, 4);

      if (car.speed < 0.25) {
        ctx.fillStyle = "#ff5a45";
        ctx.fillRect(-CAR_LEN / 2, -6, 2.5, 4);
        ctx.fillRect(-CAR_LEN / 2, 3, 2.5, 4);
      }

      if (car.siren) {
        ctx.fillStyle = "#c8433a";
        ctx.fillRect(-CAR_LEN / 2 + 3, -7, 4, 15);
        ctx.fillStyle = frames % 20 < 10 ? "#ff4d4d" : "#4d8bff";
        ctx.beginPath();
        ctx.arc(-1, 0, 3, 0, Math.PI * 2);
        ctx.fill();
      }

      if (car.patience < 0.999) {
        ctx.rotate(-a);
        const width = 22 * car.patience;
        ctx.fillStyle = "rgba(0,0,0,0.3)";
        ctx.fillRect(-11, 12, 22, 3);
        ctx.fillStyle = car.patience > 0.45 ? "#f4d35e" : "#e5503f";
        ctx.fillRect(-11, 12, width, 3);
      }
      ctx.restore();
    };

    const draw = () => {
      drawRoad();
      cars.forEach(drawCar);
      drawLights();

      if (flash > 0) {
        ctx.fillStyle = "rgba(229,80,63,0.18)";
        ctx.fillRect(0, 0, W, H);
      }

      if (!running) {
        ctx.fillStyle = "rgba(12,16,20,0.55)";
        ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = "#ffffff";
        ctx.font = "600 18px ui-sans-serif, system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("Shift over", CX, CY - 4);
        ctx.font = "13px ui-monospace, monospace";
        ctx.fillText(`${score} cars through`, CX, CY + 18);
        ctx.textAlign = "left";
      }
    };

    const frame = () => {
      if (running) step();
      draw();
      requestAnimationFrame(frame);
    };

    const typing = (target: EventTarget | null) =>
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A", "SUMMARY"].includes(target.tagName));

    window.addEventListener("keydown", (event) => {
      if (event.code !== "Space" || typing(event.target)) return;
      event.preventDefault();
      if (event.repeat) return;
      requestSwitch();
    });

    canvas.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      requestSwitch();
    });
    switchButton.addEventListener("click", requestSwitch);
    restart.addEventListener("click", () => {
      reset();
      hud.textContent = "";
    });
    window.addEventListener("resize", resize);

    const best = Number(localStorage.getItem(BEST_KEY) ?? 0);
    resize();
    reset();
    hud.textContent = best ? `Best shift: ${best} cars` : "Space or tap switches the lights";
    frame();
  }
</script>
